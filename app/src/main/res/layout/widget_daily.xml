<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="مصطلح اليوم · NewsCast 360" android:textColor="#CCFFFFFF" android:textSize="11sp" android:gravity="start" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl">
        <TextView android:id="@+id/w_term" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_en" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
    </LinearLayout>

    <TextView android:id="@+id/w_def" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F2FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:gravity="start" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="جملة اليوم" android:textColor="#CCFFFFFF" android:textSize="11sp" android:gravity="start" />
    <TextView android:id="@+id/w_wrong" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="start" />
    <TextView android:id="@+id/w_right" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:gravity="start" />
</LinearLayout>
